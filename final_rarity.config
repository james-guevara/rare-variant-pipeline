// Saved extraction products only. Does not invoke extraction or genotype QC.
params {
    rarity_manifest = null
    resource_lock = null
    select_units = null
    outdir = 'final_rarity_output'
    rarity_container = null
    rarity_memory = '4 GB'
    rarity_time = '1h'
    rarity_queue = 'small,medium'
    rarity_qos = null
    rarity_queue_size = 16
}
process.executor = 'local'
process.errorStrategy = 'terminate'
process.maxForks = 16
executor.queueSize = params.rarity_queue_size
trace.overwrite = true
profiles { nbdc { includeConfig 'conf/final-rarity-nbdc.config' } }
manifest.nextflowVersion = '>=26.04.6'
