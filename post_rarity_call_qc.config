// Call-level QC after the per-chromosome post-rarity gather (strand rule, site mean allele balance, DNM exemption).
params {
    call_qc_manifest = null
    outdir = 'post_rarity_call_qc_output'
    zarr_dir = null            // <unit>.no-pl.zarr stores; needed for the strand rule and ALT-allele counts
    dnm_rescue = null          // TSV(.gz) sample,CHROM,POS,REF,ALT (scripts/make_dnm_rescue_list.py)
    snv_site_ab_min = 0.35
    indel_site_ab_min = 0.375
    call_qc_container = null
    call_qc_memory = '8 GB'
    call_qc_time = '2h'
    call_qc_publish_mode = 'copy'
    call_qc_queue_size = 16
}
process.executor = 'local'
process.errorStrategy = 'terminate'
process.maxForks = 16
executor.queueSize = params.call_qc_queue_size
trace.overwrite = true
manifest.nextflowVersion = '>=26.04.6'
