params {
    gather_manifest = null
    select_units = null
    gather_id = null
    resource_lock = null
    outdir = 'gather_output'
    gather_container = null
    gather_cpus = 2
    gather_memory = '4 GB'
    gather_time = '2h'
    gather_queue = 'medium'
    gather_qos = 'medium'
    gather_queue_size = 4
}
process.executor = 'local'
process.errorStrategy = 'terminate'
profiles {
    nbdc { includeConfig 'conf/gather-post-qc-nbdc.config' }
}
manifest.nextflowVersion = '>=26.04.6'
