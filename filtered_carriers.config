// Filtered candidate entrypoint: invoke with -C filtered_carriers.config.
params {
    carrier_manifest = null
    psam = null
    resource_lock = null
    select_units = null
    expected_hc = null
    expected_missense = null
    outdir = 'filtered_carrier_output'
    carrier_container = null
    carrier_cpus = 1
    carrier_batch_bp = 10000
    carrier_memory = '4 GB'
    carrier_time = '4h'
    carrier_queue = 'medium'
    carrier_qos = 'medium'
    carrier_queue_size = 4
}
process.executor = 'local'
process.errorStrategy = 'terminate'
profiles {
    nbdc { includeConfig 'conf/carriers-nbdc.config' }
}
manifest.nextflowVersion = '>=26.04.6'
