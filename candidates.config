// Isolated candidate selection; never invokes annotation or carrier extraction.
params {
    candidate_manifest = null
    candidate_resource_lock = null
    candidate_resource_root = null
    candidate_container = null
    select_units = null
    outdir = 'candidate_output'
    candidate_cpus = 2
    candidate_memory = '4 GB'
    candidate_time = '2h'
    candidate_queue = 'medium'
    candidate_qos = 'medium'
    candidate_queue_size = 4
}
process.executor = 'local'
process.errorStrategy = 'terminate'
profiles {
    nbdc { includeConfig 'conf/candidates-nbdc.config' }
}
manifest.nextflowVersion = '>=26.04.6'
