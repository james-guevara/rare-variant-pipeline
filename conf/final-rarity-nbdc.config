// Existing validated SIF; this stage uses only Python's standard library.
params.rarity_container = '/home/ood-guevara-james/abcd-fastvep-smoke/containers/targeted-81e0e00a97f900867808e5f7cf17cdac6f5c5ef7956e2c6641f3188fa335d9ab.sif'
process {
    executor = 'slurm'
    queue = { params.rarity_queue }
    clusterOptions = { params.rarity_qos ? "--qos=${params.rarity_qos}" : '' }
    containerOptions = '--cleanenv'
}
executor.queueSize = params.rarity_queue_size
apptainer.enabled = true
apptainer.autoMounts = true
