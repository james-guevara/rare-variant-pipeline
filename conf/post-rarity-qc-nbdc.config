// Existing validated SIF; reuse installed Python/pysam; no new dependencies.
params.post_rarity_qc_container = '/home/ood-guevara-james/abcd-fastvep-smoke/containers/targeted-81e0e00a97f900867808e5f7cf17cdac6f5c5ef7956e2c6641f3188fa335d9ab.sif'
process {
    executor = 'slurm'
    queue = { params.post_rarity_qc_queue }
    clusterOptions = { params.post_rarity_qc_qos ? "--qos=${params.post_rarity_qc_qos}" : '' }
    containerOptions = '--cleanenv'
}
executor.queueSize = params.post_rarity_qc_queue_size
apptainer.enabled = true
apptainer.autoMounts = true
