// Reuse the validated LOFTEE SIF: it contains Python; this stage uses the standard library. No LOFTEE invocation here.
params.gather_container = '/home/ood-guevara-james/abcd-fastvep-smoke/containers/targeted-81e0e00a97f900867808e5f7cf17cdac6f5c5ef7956e2c6641f3188fa335d9ab.sif'
process {
    executor = 'slurm'
    queue = { params.gather_queue }
    clusterOptions = { params.gather_qos ? "--qos=${params.gather_qos}" : '' }
    containerOptions = '--cleanenv'
}
executor.queueSize = params.gather_queue_size
apptainer.enabled = true
apptainer.autoMounts = true
