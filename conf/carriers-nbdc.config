// Reuse the validated LOFTEE SIF: it contains Python and pysam. No LOFTEE invocation here.
params.carrier_container = '/home/ood-guevara-james/abcd-fastvep-smoke/containers/targeted-81e0e00a97f900867808e5f7cf17cdac6f5c5ef7956e2c6641f3188fa335d9ab.sif'
process {
    executor = 'slurm'
    queue = { params.carrier_queue }
    clusterOptions = { params.carrier_qos ? "--qos=${params.carrier_qos}" : '' }
    containerOptions = '--cleanenv'
}
executor.queueSize = params.carrier_queue_size
apptainer.enabled = true
apptainer.autoMounts = true
