params {
    manifest = null
    bindings = null
    targeted_container = null
    preflight_only = false
    run_root = null
    outdir = 'results'
    missing_rare_policy = 'error'
    missing_pgs_policy = 'allow'
    missing_cnv_policy = 'allow'

    // Environment adapters override only scheduler/runtime concerns.
    scheduler_queue = null
    scheduler_account = null
    container_module = null
    container_bind = null
    aws_region = 'us-east-1'
    aws_batch_volumes = null
}

process {
    errorStrategy = 'retry'
    maxRetries = 1
}

profiles {
    local_docker {
        process.executor = 'local'
        docker.enabled = true
    }

    slurm_singularity {
        process.executor = 'slurm'
        process.queue = params.scheduler_queue
        process.clusterOptions = params.scheduler_account ? "--account=${params.scheduler_account}" : ''
        process.beforeScript = params.container_module ? "module load ${params.container_module}" : ''
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.runOptions = params.container_bind ?: ''
    }

    expanse {
        process.executor = 'slurm'
        process.queue = 'ind-shared'
        process.clusterOptions = '--account=ddp195 --ntasks=1 --nodes=1'
        process.beforeScript = 'module load cpu/0.17.3b singularitypro/4.1.2'
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.runOptions = '-B /expanse/projects/sebat1'
    }

    aws_batch {
        process.executor = 'awsbatch'
        process.queue = params.scheduler_queue
        aws.region = params.aws_region
        aws.batch.volumes = params.aws_batch_volumes \
            ? params.aws_batch_volumes.split(',').collect { it.trim() }.findAll { it } \
            : []
    }
}

trace {
    enabled = true
    file = 'reports/targeted-trace.txt'
    overwrite = true
}

report {
    enabled = true
    file = 'reports/targeted-report.html'
    overwrite = true
}

timeline {
    enabled = true
    file = 'reports/targeted-timeline.html'
    overwrite = true
}

manifest {
    name = 'rare-variant-pipeline-targeted'
    version = '0.1.0'
    mainScript = 'targeted.nf'
    nextflowVersion = '26.04.6'
}
