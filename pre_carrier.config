// Independent stage; does not invoke annotation, candidate selection, or carriers.
params {
    filter_manifest = null
    filter_resource_lock = null
    filter_resource_root = null
    filter_container = null
    select_units = null
    outdir = 'pre_carrier_output'
    filter_cpus = 2
    filter_memory = '4 GB'
    filter_time = '2h'
    filter_queue = 'medium'
    filter_qos = 'medium'
    filter_queue_size = 4
}
process.executor = 'local'
process.errorStrategy = 'terminate'
profiles { nbdc { includeConfig 'conf/pre-carrier-nbdc.config' } }
manifest.nextflowVersion = '>=26.04.6'
