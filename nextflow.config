// Nextflow configuration for rare variant pipeline

// ============================================================================
// Default parameters (can be overridden via command line or profiles)
// ============================================================================

params {
    outdir = "output"
    tmpdir = "${params.outdir}/tmp"   // SORT_INDEX scratch; must be on a shared fs, not /tmp
    trace_prefix = ""
    regions_per_chunk = 5000
    single_vcf = null            // null = per-chrom VCFs; set to path for single-VCF input

    // Input dialect — what the source caller actually stores. See BCFTOOLS_NORM.
    local_alleles = false        // DRAGEN msVCF: decode LAD/LPL/LAA -> AD/PL BEFORE splitting

    // Postprocessing (POSTPROCESS subworkflow)
    pp_cohort = null             // key into resources.json "cohorts"; set per profile
    pp_resources = "${projectDir}/scripts/postprocess/resources.json"
    count_group_col = "tier"     // column PP_COUNT_CARRIERS stratifies by

    // Variant filtering
    mode = "coding"              // "coding", "regulatory", or "splicing"
    af_threshold = 1.0           // Legacy compatibility; population AF is annotation-only
    cohort_af_threshold = 1.0    // Cohort AF filtering belongs to a final explicit step
    spliceai_threshold = 0.2
    filter_repeats = false       // Exclude problematic regions before family genotyping
    regulatory_beds = "${projectDir}/resources/regulatory"

    // Containers (sandbox directories)
    bcftools_container = "/expanse/projects/sebat1/s3/data/sebat/g2mh/scripts/scripts_for_rare_pipeline/bcftools:1.22--h3a4d415_1"
    vep_container = "/expanse/projects/sebat1/s3/data/sebat/g2mh/scripts/scripts_for_rare_pipeline/ensembl-vep_115.2--pl5321h2a3209d_1.with_samtools"

    // VEP resources (absolute paths - symlinks don't work inside containers)
    vep_cache = "/expanse/projects/sebat1/s3/data/sebat/g2mh/scripts/scripts_for_rare_pipeline/VEP_CACHE"
    vep_plugins = "/expanse/projects/sebat1/s3/data/sebat/g2mh/scripts/scripts_for_rare_pipeline/VEP_PLUGINS_ALL"
    loftee_path = "/expanse/projects/sebat1/s3/data/sebat/g2mh/scripts/scripts_for_rare_pipeline/VEP_PLUGINS/loftee"
    resources_base = "/expanse/projects/sebat1/s3/data/sebat/g2mh/scripts/scripts_for_rare_pipeline/resources"
    reference = "/expanse/projects/sebat1/j3guevar/GRCh38_reference_genome/GRCh38_full_analysis_set_plus_decoy_hla.fa"

    // Python scripts and resources
    // Python stages run in a container built by CI (see Dockerfile) and fetched
    // once via scripts/pull_python_container.sh. This replaced a micromamba env at
    // an absolute path in one user's home directory, which nobody else could run.
    python_container = "/expanse/projects/sebat1/s3/data/sebat/g2mh/scripts/rare_variant_pipeline/containers/rvp_python.sif"
    prepare_script = "${projectDir}/scripts/prepare_variants.py"
    merge_script = "${projectDir}/scripts/merge_genotypes_annotations.py"
    tsv_to_parquet_script = "${projectDir}/scripts/tsv_to_parquet.py"
    resources_dir = "${projectDir}/resources"

    // QC filter thresholds
    qc_min_gq = 20
    qc_min_dp = 10
    qc_max_af = 0.001
    qc_het_ab_min = 0.25
    qc_het_ab_max = 0.75
    qc_hom_ab_min = 0.9
}

// ============================================================================
// Singularity settings
// ============================================================================

singularity {
    enabled = true
    autoMounts = true
    runOptions = '-B /expanse/projects/sebat1'
}

// ============================================================================
// Process defaults
// ============================================================================

process {
    errorStrategy = "finish"
    executor = "slurm"
    queue = "ind-shared"
    clusterOptions = "--account=ddp195 --ntasks=1 --nodes=1"
    beforeScript = "module load cpu/0.17.3b singularitypro"

    // Output directories per process
    withName: 'BCFTOOLS_NORM' {
        publishDir = [path: "${params.outdir}/norm", mode: "link"]
        memory = '16 GB'
        time = { task.attempt == 1 ? '24.h' : '48.h' }
        errorStrategy = { task.exitStatus in [137, 143] ? 'retry' : 'terminate' }
        maxRetries = 1
    }
    withName: 'BCFTOOLS_SITES' {
        publishDir = [path: "${params.outdir}/sites", mode: "link"]
        errorStrategy = 'retry'
        maxRetries = 3
    }
    withName: 'VEP_ANNOTATE' {
        publishDir = [path: "${params.outdir}/vep", mode: "link"]
        errorStrategy = 'retry'
        maxRetries = 2
    }
    withName: 'SPLIT_VEP' {
        publishDir = [path: "${params.outdir}/variants", mode: "link"]
        errorStrategy = 'retry'
        maxRetries = 2
    }
    withName: 'PREPARE_VARIANTS' {
        publishDir = [path: "${params.outdir}/reformat", mode: "link"]
    }
    withName: 'SCATTER_BED' {
        publishDir = [path: "${params.outdir}/scatter", mode: "link"]
    }
    withName: 'CARRIER_QUERY' {
        memory = { 4.GB * task.attempt }
        time = { 16.h * task.attempt }  // 2h, then 4h, then 6h
        publishDir = [path: "${params.outdir}/carrier_query", mode: "link"]
        errorStrategy = 'retry'
        maxRetries = 3
    }
    withName: 'GATHER_CARRIERS' {
        publishDir = [path: "${params.outdir}/carriers", mode: "link"]
    }
    withName: 'MERGE_ANNOTATIONS' {
        time = '2h'
        publishDir = [path: "${params.outdir}/merged", mode: "link"]
    }
    withName: 'SORT_INDEX' {
        // `sort -T` needs a scratch dir big enough for a whole chromosome and
        // visible from the compute node. Must NOT be /tmp: on Expanse /tmp is
        // node-local, so login and compute nodes see different directories.
        // Defaults under params.outdir (shared filesystem); override with --tmpdir.
        beforeScript = "module load cpu/0.17.3b singularitypro && mkdir -p ${params.tmpdir} && export TMPDIR=${params.tmpdir}"
        publishDir = [path: "${params.outdir}/indexed", mode: "link"]
    }
    withName: 'CONVERT_PARQUET' {
        publishDir = [path: "${params.outdir}/parquet", mode: "link"]
    }

    // Postprocessing stages. Sized from rv_postprocessing_v3/run_chrom.sh
    // (4 cpus / 32 GB / 2h per chrom), which these wrap unchanged.
    withName: 'PP_.*' {
        cpus = 4
        memory = '32 GB'
        time = '2h'
        errorStrategy = 'retry'
        maxRetries = 1
    }
    withName: 'PP_FILTER_REGIONS'       { publishDir = [path: "${params.outdir}/postprocess/region_filtered",      mode: "link"] }
    withName: 'PP_QC_GENOTYPE'          { publishDir = [path: "${params.outdir}/postprocess/qc_filtered",          mode: "link"] }
    withName: 'PP_JOIN_POP_AF'          { publishDir = [path: "${params.outdir}/postprocess/with_pop_af",          mode: "link"] }
    withName: 'PP_JOIN_SCORES'          { publishDir = [path: "${params.outdir}/postprocess/with_scores",          mode: "link"] }
    withName: 'PP_JOIN_GENE_CONSTRAINT' { publishDir = [path: "${params.outdir}/postprocess/with_gene_constraint", mode: "link"] }
    withName: 'PP_TIER_VARIANTS'        { publishDir = [path: "${params.outdir}/postprocess/filtered_annotated",  mode: "link"] }
    withName: 'PP_COUNT_CARRIERS'       { publishDir = [path: "${params.outdir}/postprocess/counts",                mode: "copy"] }
}

// ============================================================================
// Executor settings
// ============================================================================

executor {
    queueSize = 500
    submitRateLimit = "20/1min"
}

// ============================================================================
// Reports and tracing
// ============================================================================

trace {
    enabled = true
    file = "reports/${params.trace_prefix}trace.txt"
    overwrite = true
    fields = 'task_id,hash,native_id,process,tag,status,exit,submit,start,complete,duration,realtime,cpus,memory,rss,vmem,%cpu,%mem,queue,container'
}

report {
    enabled = true
    file = "reports/${params.trace_prefix}report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "reports/${params.trace_prefix}timeline.html"
    overwrite = true
}

// ============================================================================
// Profiles for different cohorts
// ============================================================================

profiles {
    spark_wgs {
        params.vcf_dir = "/expanse/projects/sebat1/s3/data/sebat/SPARK_iWGS_v1.1/deepvariant"
        params.vcf_pattern = "wgs_12519_genome.deepvariant.{chrom}.vcf.gz"
        params.ped_file = "${projectDir}/resources/SPARK_iWGS_v1.1.ped"
        params.pp_cohort = "spark_wgs"
    }

    spark_iwes {
        params.vcf_dir = "/expanse/projects/sebat1/s3/data/sebat/SPARK_iWES_v3/variants/snv/deepvariant/pvcf"
        params.vcf_pattern = "SPARK.iWES_v3.2024_08.deepvariant.{chrom}.vcf.gz"
        params.ped_file = "${projectDir}/resources/SPARK_iWES_v3.ped"
        params.pp_cohort = "spark_wes"
    }

    ssc {
        params.vcf_dir = "/expanse/projects/sebat1/s3/data/sebat/SSC_JG/gatk"
        params.vcf_pattern = "{chrom}.masked.vcf.gz"
        params.ped_file = "${projectDir}/resources/SSC.ped"
        params.pp_cohort = "ssc"
    }

    cirm_dragen {
        params.single_vcf = "/expanse/projects/sebat1/s3/data/sebat/NYGC_CIRM/wgs_joint_calling_all/dragen-joint.hard-filtered.vcf.gz"
        params.ped_file = "${projectDir}/resources/CIRM.ped"
    }

    cirm_gatk {
        params.vcf_dir = "/expanse/projects/sebat1/a1sriniv/milad_steven_cirm_analysis/2_vqsr/filtered_vcfs/annotated_vcfs/combined_chrs"
        params.vcf_pattern = "{chrom}_jointcall_VQSR_combined.vcf.gz"
        params.ped_file = "${projectDir}/resources/CIRM.ped"
    }

    g2mh_wo_utrecht {
        params.vcf_dir = "/expanse/projects/sebat1/a1sriniv/g2mh/2_vqsr/filtered_vcfs/annotated_vcfs/combined_chrs/wo_utrecht"
        params.vcf_pattern = "{chrom}_jointcall_VQSR_combined.vcf.gz"
        params.ped_file = "${projectDir}/resources/g2mh_wo_utrecht.ped"
        params.pp_cohort = "g2mh_wo_utrecht"
    }

    // Finalized G2MH: DRAGEN 4.4.9 msVCF delivered via NDA (collection 3228,
    // submission 82512), joint-called 2026-05-30, 1,065 samples, GRCh38.
    // Supersedes the g2mh_wo_utrecht GATK/VQSR profile above.
    //
    // Single 343 GB whole-genome VCF: per-chrom extraction happens in
    // BCFTOOLS_NORM via the index, so the cohort is read once overall.
    // local_alleles: FORMAT is GT:GQ:FT:LAD:LPL:LAA:QL:DP:SB:... (no AD/PL).
    g2mh {
        params.single_vcf = "/expanse/projects/sebat1/g2mh_data/final_download/wgs/jointcall_dragen/genomics_sample03/submission-82512/g2mh_1065_202606/g2mh_1065.vcf.gz"
        params.local_alleles = true
        params.ped_file = "${projectDir}/resources/g2mh.ped"
        params.pp_cohort = "g2mh"
    }
}

dag {
    enabled = true
    file = "reports/${params.trace_prefix}dag.html"
    overwrite = true
}

// Workflow completion summary
workflow.onComplete = {
    println """
    ===========================================
    Workflow completed: ${workflow.success ? 'SUCCESS' : 'FAILED'}
    Duration: ${workflow.duration}
    Exit status: ${workflow.exitStatus}
    ===========================================
    """.stripIndent()
}

manifest {
    name = 'rare-variant-pipeline'
    author = 'James Guevara'
    description = 'Rare variant annotation and family genotype pipeline'
    version = '1.0.0'
    mainScript = 'main.nf'
    nextflowVersion = '>=25.10.0'
}
