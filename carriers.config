// Isolated carrier entrypoint: always invoke with -C carriers.config.
params {
    carrier_manifest = null
    resource_lock = null
    select_units = null
    expected_hc = null
    outdir = 'carrier_output'
    carrier_container = null
    carrier_cpus = 2
    carrier_memory = '4 GB'
    carrier_time = '4h'
    carrier_queue = 'medium'
    carrier_qos = 'medium'
    carrier_queue_size = 4
}
process.executor = 'local'
process.errorStrategy = 'terminate'
profiles {
    nbdc { includeConfig 'conf/carriers-nbdc.config' }
}
manifest.nextflowVersion = '>=26.04.6'
