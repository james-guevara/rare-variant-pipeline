# macOS
.DS_Store

# Nextflow runtime
work/
.nextflow/
.nextflow.log*
reports/
output/
test_output/

# Large downloaded resources — fetched by scripts/download_*.sh, not versioned
resources/regulatory/
resources/regions/

# Containers are built by CI and pulled onto the cluster, never committed
*.sif

# Python bytecode
__pycache__/
*.pyc

# Downloaded region tracks
resources/repeats/
resources/gene-sets/raw/

# Terraform local state, private environment values, and saved plans
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfplan
backend.hcl
crash.log
