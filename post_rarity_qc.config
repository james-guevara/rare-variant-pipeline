// Saved final-rarity carriers only; no upstream stages or frequency recalculation.
params {
    post_rarity_qc_manifest = null
    resource_lock = null
    psam = null
    sex_chromosome_policy = null
    select_units = null
    outdir = 'post_rarity_qc_output'
    post_rarity_qc_container = null
    post_rarity_qc_memory = '4 GB'
    post_rarity_qc_time = '1h'
    post_rarity_qc_queue = 'small,medium'
    post_rarity_qc_qos = null
    post_rarity_qc_queue_size = 16
}
process.executor = 'local'
process.errorStrategy = 'terminate'
process.maxForks = 16
executor.queueSize = params.post_rarity_qc_queue_size
trace.overwrite = true
profiles { nbdc { includeConfig 'conf/post-rarity-qc-nbdc.config' } }
manifest.nextflowVersion = '>=26.04.6'
