// Use -C sites_catalog.config to avoid the full workflow's site-specific defaults.
params {
    sites_manifest = null
    sites_publish_mode = 'copy'
    outdir = 'sites_catalog_output'
    bcftools_container = 'quay.io/biocontainers/bcftools:1.22--h3a4d415_1'
}
process.executor = 'local'
profiles {
    docker { docker.enabled = true }
    singularity { singularity.enabled = true; singularity.autoMounts = true }
}
manifest.nextflowVersion = '>=25.10.0'
